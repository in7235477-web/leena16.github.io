<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>자기소개 - 홍길동</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&family=Noto+Serif+KR:wght@500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #e8f0ef;
      --bg-alt: #f4f8f7;
      --ink: #1c2b2a;
      --muted: #5a6e6c;
      --accent: #0f766e;
      --accent-soft: #ccfbf1;
      --line: #c5d4d1;
      --hero-top: #d4e8e4;
      --hero-mid: #b8d4cf;
      --hero-bottom: #9bbfb8;
      --max: 720px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "IBM Plex Sans KR", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(ellipse 80% 50% at 10% 0%, #c5ddd8 0%, transparent 55%),
        radial-gradient(ellipse 60% 40% at 90% 20%, #dce8e4 0%, transparent 50%),
        linear-gradient(180deg, var(--bg) 0%, var(--bg-alt) 40%, #eef3f2 100%);
      background-attachment: fixed;
      line-height: 1.75;
      font-weight: 400;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    a:hover {
      color: #0d9488;
    }

    /* Top nav */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(10px);
      background: rgba(232, 240, 239, 0.85);
      border-bottom: 1px solid var(--line);
      padding: 14px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    .site-nav .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
      letter-spacing: -0.02em;
    }

    .site-nav .brand-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
      background: #f0f7f5;
      border: 1.5px solid var(--line);
    }

    .site-nav .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      justify-content: flex-end;
    }

    .site-nav .nav-links a {
      color: var(--muted);
      font-size: 0.88rem;
      font-weight: 500;
      position: relative;
    }

    .site-nav .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 0;
      height: 2px;
      background: var(--accent);
      transition: width 0.25s ease;
    }

    .site-nav .nav-links a:hover,
    .site-nav .nav-links a.active {
      color: var(--ink);
    }

    .site-nav .nav-links a:hover::after,
    .site-nav .nav-links a.active::after {
      width: 100%;
    }

    /* Scroll progress */
    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      background: var(--accent);
      z-index: 200;
      transition: width 0.05s linear;
    }

    /* Back to top */
    .back-to-top {
      position: fixed;
      right: 24px;
      bottom: 24px;
      width: 44px;
      height: 44px;
      border: 1px solid var(--line);
      background: rgba(244, 248, 247, 0.95);
      color: var(--ink);
      font-size: 1.1rem;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease, background 0.2s ease;
      z-index: 150;
    }

    .back-to-top.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .back-to-top:hover {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }

    /* Hero */
    .hero {
      min-height: 88vh;
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 48px 56px;
      padding: 80px 24px 100px;
      max-width: 920px;
      margin: 0 auto;
      position: relative;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 12% -8% auto auto;
      width: min(380px, 50vw);
      height: min(380px, 50vw);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(15, 118, 110, 0.12) 0%, transparent 70%);
      pointer-events: none;
      animation: drift 12s ease-in-out infinite alternate;
      z-index: 0;
    }

    @keyframes drift {
      from { transform: translate(0, 0); }
      to { transform: translate(-30px, 24px); }
    }

    .hero-portrait {
      position: relative;
      z-index: 1;
      width: clamp(140px, 22vw, 200px);
      flex-shrink: 0;
      animation: rise 0.8s ease both;
    }

    .hero-portrait::before {
      content: "";
      position: absolute;
      inset: -10px;
      border-radius: 50%;
      background: linear-gradient(145deg, rgba(15, 118, 110, 0.22), rgba(197, 212, 209, 0.15));
      z-index: -1;
      animation: softPulse 4s ease-in-out infinite;
    }

    @keyframes softPulse {
      0%, 100% { transform: scale(1); opacity: 0.85; }
      50% { transform: scale(1.04); opacity: 1; }
    }

    .hero-portrait img {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      border-radius: 50%;
      object-fit: cover;
      object-position: center 20%;
      background: #f7fbfa;
      border: 3px solid rgba(255, 255, 255, 0.9);
      box-shadow:
        0 0 0 1px var(--line),
        0 18px 40px rgba(28, 43, 42, 0.1);
      transition: transform 0.35s ease;
    }

    .hero-portrait:hover img {
      transform: scale(1.03) rotate(-2deg);
    }

    .hero-copy {
      position: relative;
      z-index: 1;
      min-width: 0;
    }

    .hero h1 {
      font-size: clamp(3rem, 9vw, 5.2rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1.1;
      color: var(--ink);
      margin-bottom: 18px;
      animation: rise 0.8s ease 0.08s both;
    }

    .hero .tagline {
      font-size: clamp(1.05rem, 2.5vw, 1.25rem);
      color: var(--muted);
      font-weight: 400;
      max-width: 26em;
      margin-bottom: 32px;
      min-height: 2.6em;
      animation: rise 0.8s ease 0.18s both;
    }

    .hero .cta {
      display: inline-block;
      background: var(--accent);
      color: #fff;
      padding: 14px 28px;
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: -0.01em;
      transition: background 0.2s ease, transform 0.2s ease;
      animation: rise 0.8s ease 0.3s both;
    }

    .hero .cta:hover {
      background: #0d9488;
      color: #fff;
      transform: translateY(-2px);
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Sections */
    main {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 24px 80px;
    }

    section {
      padding: 72px 0;
      border-top: 1px solid var(--line);
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    section.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .greeting {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--accent);
      margin-bottom: 12px;
      min-height: 1.4em;
      animation: rise 0.8s ease 0.05s both;
    }

    .tagline .cursor {
      display: inline-block;
      width: 2px;
      height: 1.1em;
      background: var(--accent);
      margin-left: 2px;
      vertical-align: text-bottom;
      animation: blink 0.8s step-end infinite;
    }

    @keyframes blink {
      50% { opacity: 0; }
    }

    .copy-btn {
      margin-left: 8px;
      padding: 2px 10px;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--muted);
      font-family: inherit;
      font-size: 0.8rem;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .copy-btn:hover,
    .copy-btn.copied {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }

    .project {
      cursor: pointer;
    }

    .project h3 {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .project h3::after {
      content: "+";
      font-weight: 400;
      color: var(--accent);
      font-size: 1.3rem;
      line-height: 1;
      transition: transform 0.25s ease;
    }

    .project.open h3::after {
      content: "−";
    }

    .project .project-body {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.35s ease, opacity 0.3s ease, margin 0.3s ease;
      margin-top: 0;
    }

    .project.open .project-body {
      max-height: 120px;
      opacity: 1;
      margin-top: 8px;
    }

    section h2 {
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 16px;
    }

    section p {
      color: var(--ink);
      font-size: 1.05rem;
      font-weight: 300;
    }

    section ul {
      list-style: none;
    }

    section ul li {
      position: relative;
      padding-left: 1.2em;
      margin-bottom: 10px;
      color: var(--ink);
      font-weight: 300;
      font-size: 1.05rem;
    }

    section ul li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.7em;
      width: 6px;
      height: 6px;
      background: var(--accent);
    }

    /* Skills — simple horizontal flow, not pill cluster */
    .skills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 0;
    }

    .skills-list li {
      padding-left: 0;
      margin-bottom: 0;
      margin-right: 28px;
      font-weight: 500;
      font-size: 1.1rem;
    }

    .skills-list li::before {
      display: none;
    }

    .skills-list li:not(:last-child)::after {
      content: "/";
      margin-left: 28px;
      color: var(--line);
      font-weight: 300;
    }

    /* Projects */
    .project {
      margin-top: 28px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
    }

    .project:first-of-type {
      margin-top: 8px;
    }

    .project:last-of-type {
      border-bottom: none;
    }

    .project h3 {
      font-size: 1.2rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 0;
      color: var(--ink);
    }

    .project p {
      color: var(--muted);
    }

    /* Motto */
    #motto blockquote {
      border: none;
      margin: 0;
    }

    #motto blockquote p {
      font-family: "Noto Serif KR", serif;
      font-size: clamp(1.4rem, 3.5vw, 1.85rem);
      font-weight: 500;
      line-height: 1.55;
      letter-spacing: -0.02em;
      color: var(--ink);
    }

    /* Hobby */
    #hobby p {
      font-size: 1.15rem;
      letter-spacing: -0.01em;
    }

    /* Contact */
    #contact ul li {
      font-weight: 400;
    }

    #contact ul li::before {
      background: var(--ink);
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 32px 24px 48px;
      color: var(--muted);
      font-size: 0.88rem;
      border-top: 1px solid var(--line);
    }

    @media (max-width: 720px) {
      .site-nav {
        flex-direction: column;
        align-items: flex-start;
        padding: 12px 20px;
      }

      .site-nav .nav-links {
        justify-content: flex-start;
        gap: 6px 14px;
      }

      .site-nav .nav-links a {
        font-size: 0.8rem;
      }

      .hero {
        min-height: auto;
        padding: 56px 20px 72px;
        grid-template-columns: 1fr;
        gap: 28px;
        justify-items: start;
      }

      .hero-portrait {
        width: 120px;
      }

      .hero h1 {
        font-size: clamp(2.6rem, 12vw, 3.4rem);
      }

      section {
        padding: 56px 0;
      }

      .skills-list li {
        margin-right: 16px;
      }

      .skills-list li:not(:last-child)::after {
        margin-left: 16px;
      }
    }
  </style>
</head>
<body>

  <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

  <nav class="site-nav">
    <a href="#" class="brand" id="brandLink">
      <img src="P.png" alt="" class="brand-avatar" width="32" height="32">
      홍길동
    </a>
    <div class="nav-links" id="navLinks">
      <a href="#about">소개</a>
      <a href="#personality">성격</a>
      <a href="#strengths">장점</a>
      <a href="#weaknesses">단점</a>
      <a href="#skills">기술</a>
      <a href="#interests">관심</a>
      <a href="#projects">프로젝트</a>
      <a href="#hobby">취미</a>
      <a href="#motto">좌우명</a>
      <a href="#goal">목표</a>
      <a href="#contact">연락처</a>
    </div>
  </nav>

  <header class="hero">
    <div class="hero-portrait">
      <img src="P.png" alt="홍길동 프로필 사진" width="200" height="200">
    </div>
    <div class="hero-copy">
      <p class="greeting" id="greeting"></p>
      <h1>홍길동</h1>
      <p class="tagline"><span id="taglineText"></span><span class="cursor" id="taglineCursor" aria-hidden="true"></span></p>
      <a href="#contact" class="cta">연락하기</a>
    </div>
  </header>

  <main>

    <section id="about">
      <h2>자기소개</h2>
      <p>
        안녕하세요. 저는 새로운 기술을 배우고 직접 만들어 보는 것을 좋아하는 사람입니다.
        컴퓨터와 프로그래밍에 관심을 가지게 되면서 다양한 프로젝트를 진행했고,
        문제를 해결하는 과정에서 큰 보람을 느꼈습니다.
        앞으로도 꾸준히 공부하며 사용자에게 도움이 되는 서비스를 개발하는 것이 목표입니다.
      </p>
    </section>

    <section id="personality">
      <h2>성격</h2>
      <p>
        책임감이 강하고 맡은 일은 끝까지 해결하려는 성향을 가지고 있습니다.
        새로운 환경에도 빠르게 적응하며 다양한 사람들과 원활하게 소통하려고 노력합니다.
        계획을 세워 차근차근 일을 진행하는 것을 좋아하며,
        부족한 부분은 꾸준한 학습을 통해 보완하고 있습니다.
      </p>
    </section>

    <section id="strengths">
      <h2>장점</h2>
      <ul>
        <li>책임감이 강하다.</li>
        <li>새로운 기술을 배우는 것을 좋아한다.</li>
        <li>문제 해결 능력이 뛰어나다.</li>
        <li>팀원들과 원활하게 협업할 수 있다.</li>
        <li>계획적으로 업무를 수행한다.</li>
      </ul>
    </section>

    <section id="weaknesses">
      <h2>단점</h2>
      <p>
        완벽하게 수행하려는 성향 때문에 시간이 다소 오래 걸리는 경우가 있습니다.
        하지만 우선순위를 정하고 적절한 시간 안에 마무리하는 습관을 기르기 위해 노력하고 있습니다.
      </p>
    </section>

    <section id="skills">
      <h2>기술 스택</h2>
      <ul class="skills-list">
        <li>HTML</li>
        <li>CSS</li>
        <li>JavaScript</li>
        <li>Python</li>
        <li>Git</li>
        <li>Cursor AI</li>
      </ul>
    </section>

    <section id="interests">
      <h2>관심 분야</h2>
      <p>
        웹 프론트엔드 개발, 사용자 경험(UX), 인공지능을 활용한 웹 서비스 개발에 관심이 있습니다.
      </p>
    </section>

    <section id="projects">
      <h2>프로젝트 경험</h2>

      <article class="project open">
        <h3>학생 성적 관리 프로그램</h3>
        <div class="project-body">
          <p>
            Python을 이용하여 학생 정보를 입력하고 평균과 등급을 계산하는 프로그램을 제작하였습니다.
          </p>
        </div>
      </article>

      <article class="project">
        <h3>병원 환자 관리 프로그램</h3>
        <div class="project-body">
          <p>
            환자의 정보를 관리하고 조건문과 반복문을 활용하여 진료 대기 현황을 확인할 수 있는 프로그램을 구현하였습니다.
          </p>
        </div>
      </article>

      <article class="project">
        <h3>자기소개 웹페이지 제작</h3>
        <div class="project-body">
          <p>
            HTML과 CSS를 활용하여 자기소개 페이지를 만들고 JavaScript를 이용해 다양한 동작을 구현하였습니다.
          </p>
        </div>
      </article>
    </section>

    <section id="hobby">
      <h2>취미</h2>
      <p>독서, 음악 감상, 여행, 운동, 새로운 IT 기술 공부</p>
    </section>

    <section id="motto">
      <h2>좌우명</h2>
      <blockquote>
        <p>"작은 노력들이 모여 큰 변화를 만든다."</p>
      </blockquote>
    </section>

    <section id="goal">
      <h2>목표</h2>
      <p>
        사용자가 편리하게 이용할 수 있는 웹 서비스를 직접 기획하고 개발하는 개발자가 되는 것이 목표입니다.
        꾸준한 학습과 다양한 프로젝트 경험을 통해 실력을 키워 나가겠습니다.
      </p>
    </section>

    <section id="contact">
      <h2>연락처</h2>
      <ul>
        <li>
          이메일: <a href="mailto:hong@example.com" id="emailLink">hong@example.com</a>
          <button type="button" class="copy-btn" id="copyEmailBtn">복사</button>
        </li>
        <li>GitHub: <a href="https://github.com/hong" target="_blank" rel="noopener noreferrer">https://github.com/hong</a></li>
      </ul>
    </section>

  </main>

  <footer>
    <p>&copy; 2026 홍길동</p>
  </footer>

  <button type="button" class="back-to-top" id="backToTop" aria-label="맨 위로">↑</button>

  <script>
    (function () {
      const TAGLINE = "배움을 즐기고 새로운 기술에 도전하는 예비 웹 개발자입니다.";
      const EMAIL = "hong@example.com";

      const greetingEl = document.getElementById("greeting");
      const taglineText = document.getElementById("taglineText");
      const taglineCursor = document.getElementById("taglineCursor");
      const scrollProgress = document.getElementById("scrollProgress");
      const backToTop = document.getElementById("backToTop");
      const navLinks = document.querySelectorAll("#navLinks a");
      const sections = document.querySelectorAll("main section");
      const projects = document.querySelectorAll(".project");
      const copyEmailBtn = document.getElementById("copyEmailBtn");
      const brandLink = document.getElementById("brandLink");

      // 시간대별 인사말
      function setGreeting() {
        const hour = new Date().getHours();
        let message = "안녕하세요.";
        if (hour < 12) message = "좋은 아침입니다.";
        else if (hour < 18) message = "좋은 오후입니다.";
        else message = "좋은 저녁입니다.";
        greetingEl.textContent = message;
      }

      // 타이핑 효과
      function typeTagline() {
        let index = 0;
        taglineText.textContent = "";

        function type() {
          if (index < TAGLINE.length) {
            taglineText.textContent += TAGLINE.charAt(index);
            index += 1;
            setTimeout(type, 45);
          } else {
            setTimeout(function () {
              taglineCursor.style.display = "none";
            }, 1200);
          }
        }

        type();
      }

      // 스크롤 진행률 바 + 맨 위로 버튼
      function onScroll() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        scrollProgress.style.width = progress + "%";

        if (scrollTop > 400) {
          backToTop.classList.add("visible");
        } else {
          backToTop.classList.remove("visible");
        }

        updateActiveNav();
      }

      // 현재 섹션에 맞는 메뉴 강조
      function updateActiveNav() {
        const offset = 120;
        let currentId = "";

        sections.forEach(function (section) {
          const top = section.offsetTop - offset;
          if (window.scrollY >= top) {
            currentId = section.id;
          }
        });

        navLinks.forEach(function (link) {
          const href = link.getAttribute("href");
          if (href === "#" + currentId) {
            link.classList.add("active");
          } else {
            link.classList.remove("active");
          }
        });
      }

      // 섹션 스크롤 등장
      function observeSections() {
        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
              }
            });
          },
          { threshold: 0.15 }
        );

        sections.forEach(function (section) {
          observer.observe(section);
        });
      }

      // 프로젝트 아코디언
      function setupProjects() {
        projects.forEach(function (project) {
          project.addEventListener("click", function () {
            const isOpen = project.classList.contains("open");
            projects.forEach(function (item) {
              item.classList.remove("open");
            });
            if (!isOpen) {
              project.classList.add("open");
            }
          });
        });
      }

      // 이메일 복사
      function setupCopyEmail() {
        copyEmailBtn.addEventListener("click", function () {
          navigator.clipboard.writeText(EMAIL).then(function () {
            copyEmailBtn.textContent = "복사됨!";
            copyEmailBtn.classList.add("copied");
            setTimeout(function () {
              copyEmailBtn.textContent = "복사";
              copyEmailBtn.classList.remove("copied");
            }, 1500);
          }).catch(function () {
            copyEmailBtn.textContent = "실패";
            setTimeout(function () {
              copyEmailBtn.textContent = "복사";
            }, 1500);
          });
        });
      }

      // 맨 위로
      backToTop.addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      brandLink.addEventListener("click", function (event) {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      setGreeting();
      typeTagline();
      observeSections();
      setupProjects();
      setupCopyEmail();
      window.addEventListener("scroll", onScroll);
      onScroll();
    })();
  </script>

</body>
</html>
